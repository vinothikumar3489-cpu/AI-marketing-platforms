  type                  GraphEntityType
  name                  String
  canonicalName         String?
  aliases               Json?
  chatId                String?
  userId                String?
  source                String?
  sourceId              String?
  confidence            Float               @default(0.5)
  sourceCount           Int                 @default(1)
  lastSeen              DateTime            @default(now())
  freshness             String?
  metadata              Json?
  embedding             Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  outgoingRelationships GraphRelationship[] @relation("Outgoing")
  incomingRelationships GraphRelationship[] @relation("Incoming")

  @@unique([type, canonicalName])
  @@index([type])
  @@index([name])
  @@index([canonicalName])
  @@index([chatId])
  @@index([userId])
  @@index([confidence])
  @@index([lastSeen])
}

model GraphRelationship {
  id            String                @id @default(cuid())
  type          GraphRelationshipType
  fromId        String
  toId          String
  confidence    Float                 @default(0.7)
  evidenceCount Int                   @default(1)
  reason        String?
  sources       Json?
  chatId        String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  from          GraphEntity           @relation("Outgoing", fields: [fromId], references: [id], onDelete: Cascade)
  to            GraphEntity           @relation("Incoming", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@index([confidence])
  @@index([chatId])
}

model DealInsight {
  id                      String   @id @default(cuid())
  userId                  String
  chatId                  String
  dealId                  String
  aiSummary               String?
  buyingSignals           Json?
  riskFactors             Json?
  recommendedNextStep     Json?
  competitorMention       String?
  fleetSizeEstimate       Json?
  decisionMakerConfidence Json?
  timelinePrediction      Json?
  generationStatus        String   @default("pending")
  provider                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  chat                    Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  deal                    CRMDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([chatId])
  @@index([userId])
}

model Proposal {
  id                     String      @id @default(cuid())
  userId                 String
  chatId                 String
  dealId                 String?
  contactId              String?
  companyId              String?
  title                  String
  proposalType           String
  executiveSummary       String?
  pricingSummary         Json?
  fleetRecommendations   Json?
  implementationTimeline Json?
  status                 String      @default("DRAFT")
  content                Json?
  generatedBy            String?
  provider               String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  chat                   Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  company                CRMCompany? @relation(fields: [companyId], references: [id])
  contact                CRMContact? @relation(fields: [contactId], references: [id])
  deal                   CRMDeal?    @relation(fields: [dealId], references: [id])
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([chatId])
  @@index([status])
  @@index([userId])
}

model CustomerHealthSnapshot {
  id                    String      @id @default(cuid())
  userId                String
  chatId                String
  contactId             String?
  companyId             String?
  dealId                String?
  healthStatus          String
  riskFlags             Json?
  inactivityDays        Int?
  daysSinceLastActivity Int?
  daysSinceLastTask     Int?
  daysSinceLastMeeting  Int?
  openDealCount         Int         @default(0)
  overdueTaskCount      Int         @default(0)
  hasUpcomingRenewal    Boolean     @default(false)
  missingOwner          Boolean     @default(false)
  staleDeal             Boolean     @default(false)
  calculatedAt          DateTime    @default(now())
  chat                  Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  company               CRMCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact               CRMContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal                  CRMDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, healthStatus])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@index([calculatedAt])
  @@index([userId])
}

enum GraphEntityType {
  Company
  Product
  Competitor
  Industry
  Audience
  Persona
  Keyword
  Feature
  Benefit
  PainPoint
  UseCase
  Campaign
  MarketingChannel
  Website
  SocialPlatform
  Country
  Region
  Language
  Technology
  Integration
  Pricing
  Review
  ContentAsset
}

enum GraphRelationshipType {
  OWNS
  COMPETES_WITH
  TARGETS
  BELONGS_TO
  HAS_FEATURE
  CREATES
  SOLVED_BY
  PROMOTES
  OPERATES_IN
  CONNECTS_TO
}
