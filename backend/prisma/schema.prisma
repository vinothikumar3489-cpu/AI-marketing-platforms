generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastActiveAt            DateTime?
  profileImage            String?
  role                    String?                  @default("member")
  agentRuns               AgentRun[]
  analyses                Analysis[]
  automationLogs          AutomationLog[]
  automationPlans         AutomationPlan[]
  crmActivities           CRMActivity[]
  crmCompanies            CRMCompany[]
  crmContacts             CRMContact[]
  crmDeals                CRMDeal[]
  crmImportJobs           CRMImportJob[]
  crmPipelines            CRMPipeline[]
  crmTasks                CRMTask[]
  crmWorkflows            CRMWorkflow[]
  campaignIntelligence    CampaignIntelligence[]
  campaignPlans           CampaignPlan[]
  chats                   Chat[]
  competitorIntelligence  CompetitorIntelligence[]
  customerHealthSnapshots CustomerHealthSnapshot[]
  dealInsights            DealInsight[]
  emailAutomations        EmailAutomation[]
  emailCampaigns          EmailCampaign[]
  emailTemplates          EmailTemplate[]
  evidenceSnapshots       EvidenceSnapshot[]
  executionRecords        ExecutionRecord[]
  growthSprints           GrowthSprint[]
  growthTasks             GrowthTask[]
  notifications           Notification[]
  productAnalyses         ProductAnalysis[]
  productIntelligence     ProductIntelligence[]
  productProfiles         ProductProfile[]
  proposals               Proposal[]
  salesCopilotMemories    SalesCopilotMemory[]
  seoAnalyses             SeoAnalysis[]
  seoIntelligence         SeoIntelligence[]
}

model Chat {
  id                      String                   @id @default(cuid())
  userId                  String
  title                   String
  productName             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  AgentRun                AgentRun[]
  analysis                Analysis[]
  automationPlan          AutomationPlan?
  crmActivities           CRMActivity[]
  crmCompanies            CRMCompany[]
  crmContacts             CRMContact[]
  crmDeals                CRMDeal[]
  crmImportJobs           CRMImportJob[]
  crmPipelines            CRMPipeline[]
  crmTasks                CRMTask[]
  crmWorkflows            CRMWorkflow[]
  campaignIntelligence    CampaignIntelligence?
  campaignPlans           CampaignPlan?
  user                    User                     @relation(fields: [userId], references: [id])
  competitorIntelligence  CompetitorIntelligence?
  customerHealthSnapshots CustomerHealthSnapshot[]
  dealInsights            DealInsight[]
  emailAutomations        EmailAutomation[]
  emailCampaigns          EmailCampaign[]
  emailTemplates          EmailTemplate[]
  evidenceSnapshots       EvidenceSnapshot[]
  executionRecords        ExecutionRecord[]
  growthSprints           GrowthSprint[]
  growthTasks             GrowthTask[]
  messages                Message[]
  productAnalysis         ProductAnalysis?
  productIntelligence     ProductIntelligence?
  productProfile          ProductProfile?
  proposals               Proposal[]
  salesCopilotMemories    SalesCopilotMemory[]
  seoAnalysis             SeoAnalysis?
  seoIntelligence         SeoIntelligence?

  @@index([userId])
}

model Message {
  id           String   @id @default(cuid())
  chatId       String
  role         String
  content      String
  analysisData Json?
  createdAt    DateTime @default(now())
  chat         Chat     @relation(fields: [chatId], references: [id])

  @@index([chatId])
}

model Analysis {
  id                  String             @id @default(cuid())
  chatId              String
  userId              String
  productName         String
  productDescription  String
  targetAudience      String
  marketInsights      Json?
  competitorInsights  Json?
  campaignSuggestions Json?
  roiSuggestions      Json?
  createdAt           DateTime           @default(now())
  chat                Chat               @relation(fields: [chatId], references: [id])
  user                User               @relation(fields: [userId], references: [id])
  evidenceSnapshots   EvidenceSnapshot[]

  @@index([chatId])
  @@index([userId])
}

model SeoAnalysis {
  id                 String   @id @default(cuid())
  chatId             String   @unique
  userId             String
  websiteUrl         String?
  seoScore           Int?
  visibilityScore    Int?
  organicTraffic     Int?
  keywordCount       Int?
  backlinkCount      Int?
  avgPosition        Float?
  ctr                Float?
  topKeywords        Json?
  competitorKeywords Json?
  backlinks          Json?
  trafficEstimate    Json?
  technicalIssues    Json?
  contentSuggestions Json?
  prediction         Json?
  source             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  chat               Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProductProfile {
  id             String   @id @default(cuid())
  chatId         String   @unique
  userId         String
  productName    String
  companyName    String?
  websiteUrl     String?
  description    String?
  industry       String?
  targetAudience String?
  pricing        String?
  competitors    String?
  businessGoal   String?
  scrapedData    Json?
  mergedData     Json?
  scrapeStatus   String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model ProductAnalysis {
  id                  String   @id @default(cuid())
  chatId              String   @unique
  userId              String
  productSummary      String?
  category            String?
  confidenceScore     Int?
  usp                 Json?
  painPoints          Json?
  targetUsers         Json?
  competitorTypes     Json?
  marketingAngles     Json?
  pricingPosition     String?
  recommendedModules  Json?
  source              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  aiWarnings          Json?
  benefits            Json?
  buyerPersonas       Json?
  competitors         Json?
  dataSourcesUsed     Json?
  features            Json?
  marketMaturity      String?
  providers           Json?
  warnings            Json?
  businessModel       String?
  campaignIdeas       Json?
  marketSegment       String?
  revenueModel        String?
  seoOpportunities    Json?
  apiStatus           Json?
  confidenceBreakdown Json?
  directCompetitors   Json?
  emergingCompetitors Json?
  fallbackUsed        Boolean? @default(false)
  indirectCompetitors Json?
  inputJson           Json?
  outputJson          Json?
  provider            String?
  recommendedChannels Json?
  caseStudies         Json?
  customerSegments    Json?
  faq                 Json?
  resources           Json?
  schemaOrg           Json?
  technologyStack     Json?
  testimonials        Json?
  useCases            Json?
  chat                Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model ProductIntelligence {
  id                   String   @id @default(cuid())
  chatId               String   @unique
  userId               String
  productAnalysis      Json?
  marketDiscovery      Json?
  audienceIntelligence Json?
  provider             String?
  fallbackUsed         Boolean? @default(false)
  inputJson            Json?
  status               String?  @default("pending")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  chat                 Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model CompetitorIntelligence {
  id                 String   @id @default(cuid())
  chatId             String   @unique
  userId             String
  competitorAnalysis Json?
  intentPrediction   Json?
  positioningEngine  Json?
  provider           String?
  fallbackUsed       Boolean? @default(false)
  inputJson          Json?
  status             String?  @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  chat               Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model CampaignIntelligence {
  id                    String   @id @default(cuid())
  chatId                String   @unique
  userId                String
  campaignGenerator     Json?
  channelRecommendation Json?
  provider              String?
  fallbackUsed          Boolean? @default(false)
  inputJson             Json?
  status                String?  @default("pending")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  actionPlan            Json?
  executiveStory        Json?
  chat                  Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model CampaignPlan {
  id                     String          @id @default(cuid())
  userId                 String
  chatId                 String          @unique
  executiveSummary       Json?
  businessGoal           Json?
  campaignObjective      Json?
  audienceSelection      Json?
  channelRecommendations Json?
  timeline               Json?
  marketingFunnel        Json?
  kpiFramework           Json?
  riskAssessment         Json?
  opportunityAssessment  Json?
  nextActions            Json?
  status                 String?         @default("draft")
  provider               String?
  fallbackUsed           Boolean?        @default(false)
  inputJson              Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  version                Int?            @default(1)
  marketingStrategy      Json?
  emailCampaignsData     Json?
  ads                    Json?
  landingPages           Json?
  socialPosts            Json?
  creativeAngles         Json?
  budget                 Json?
  forecast               Json?
  roi                    Json?
  crmDeals               CRMDeal[]
  crmWorkflows           CRMWorkflow[]
  chat                   Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailCampaigns         EmailCampaign[]

  @@index([chatId])
  @@index([userId])
}

model GrowthSprint {
  id        String       @id @default(cuid())
  chatId    String
  userId    String
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    String       @default("active")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  chat      Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     GrowthTask[]

  @@index([chatId])
  @@index([userId])
}

model GrowthTask {
  id              String        @id @default(cuid())
  chatId          String
  userId          String
  sprintId        String?
  title           String
  description     String?
  status          String        @default("todo")
  priority        String        @default("Medium")
  difficulty      String?
  impact          String?
  owner           String?       @default("Marketing Team")
  kpi             String?
  estimatedTime   String?
  targetKeyword   String?
  affectedPage    String?
  progress        Int           @default(0)
  isCompleted     Boolean       @default(false)
  completedAt     DateTime?
  dueDate         DateTime?
  aiGeneratedType String?
  aiPromptContext Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sprint          GrowthSprint? @relation(fields: [sprintId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([userId])
  @@index([sprintId])
}

model SeoIntelligence {
  id                     String                      @id @default(cuid())
  chatId                 String                      @unique
  userId                 String
  websiteUrl             String?
  seoScore               Int?
  technicalAudit         Json?
  keywordOpportunities   Json?
  competitorKeywords     Json?
  contentGaps            Json?
  aiVisibility           Json?
  landingPageSuggestions Json?
  blogIdeas              Json?
  actionPlan             Json?
  providers              Json?
  warnings               Json?
  status                 String?                     @default("pending")
  fallbackUsed           Boolean?                    @default(false)
  inputJson              Json?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  analyzedAt             DateTime?                   @default(now())
  companyName            String?
  domain                 String?
  productName            String?
  blogIntelligenceItems  BlogIntelligence[]
  blogIntelligenceRecord BlogIntelligenceRecord?
  competitorSeoRecord    CompetitorSeoRecord?
  contentGapDetails      ContentGap[]
  contentGapRecord       ContentGapRecord?
  executiveDashboard     ExecutiveSeoDashboard?
  geoIntelligence        GeoIntelligenceRecord?
  keywordIntelligence    KeywordIntelligenceRecord?
  rawCrawlData           RawCrawlData[]
  seoCompetitors         SeoCompetitorIntelligence[]
  chat                   Chat                        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreBreakdown         SeoScoreBreakdown?
  technicalAuditDetail   TechnicalSeoAudit?
  topicClusters          TopicCluster[]

  @@index([userId])
  @@index([chatId])
}

model RawCrawlData {
  id                String          @id @default(cuid())
  seoIntelligenceId String
  url               String
  html              String
  text              String
  metadata          Json
  technical         Json
  content           Json
  structured        Json
  provider          String
  scrapedAt         DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model TechnicalSeoAudit {
  id                String          @id @default(cuid())
  seoIntelligenceId String          @unique
  auditData         Json
  overallScore      Int?
  titleScore        Int?
  metaScore         Int?
  securityScore     Int?
  mobileScore       Int?
  headingScore      Int?
  schemaScore       Int?
  criticalIssues    Json
  highIssues        Json
  mediumIssues      Json
  lowIssues         Json
  recommendations   Json
  analyzedAt        DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)
}

model SeoScoreBreakdown {
  id                String          @id @default(cuid())
  seoIntelligenceId String          @unique
  technicalScore    Int?
  onPageScore       Int?
  contentScore      Int?
  authorityScore    Int?
  aiVisibilityScore Int?
  localSeoScore     Int?
  overallScore      Int?
  scoreHistory      Json?
  lastCalculated    DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)
}

model KeywordIntelligenceRecord {
  id                   String          @id @default(cuid())
  seoIntelligenceId    String          @unique
  primaryKeywords      Json
  secondaryKeywords    Json
  longTailKeywords     Json
  questionKeywords     Json
  clusters             Json
  competitorKeywords   Json
  contentOpportunities Json
  geoKeywords          Json
  totalKeywords        Int?            @default(0)
  clustersCount        Int?            @default(0)
  opportunitiesCount   Int?            @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  seoIntelligence      SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model TopicCluster {
  id                 String          @id @default(cuid())
  seoIntelligenceId  String
  name               String
  keywords           Json
  priority           Int
  contentSuggestions Json
  createdAt          DateTime        @default(now())
  seoIntelligence    SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId, priority])
}

model SeoCompetitorIntelligence {
  id                String          @id @default(cuid())
  seoIntelligenceId String
  name              String
  website           String
  type              String
  reason            String
  strengths         Json
  weaknesses        Json
  contentStrategy   String?
  positioning       String?
  seoAdvantages     Json
  keywordGaps       Json
  contentGaps       Json
  authorityGaps     Json
  authorityEstimate Int?
  createdAt         DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId, type])
}

model GeoIntelligenceRecord {
  id                           String          @id @default(cuid())
  seoIntelligenceId            String          @unique
  aiVisibilityScore            Int?
  chatGptScore                 Int?
  geminiScore                  Int?
  claudeScore                  Int?
  perplexityScore              Int?
  googleAiOverviewScore        Int?
  entityCoverageScore          Int?
  knowledgeGraphReadinessScore Int?
  citationReadinessScore       Int?
  answerabilityScore           Int?
  topicalAuthorityScore        Int?
  entities                     Json
  knowledgeGraphEntities       Json
  citationOpportunities        Json
  faqOpportunities             Json
  aiContentOpportunities       Json
  trustSignals                 Json
  recommendations              Json
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  seoIntelligence              SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model ContentGap {
  id                String          @id @default(cuid())
  seoIntelligenceId String
  type              String
  title             String
  reason            String
  opportunityScore  Int?
  priority          String
  competitors       Json
  suggestedPage     String?
  createdAt         DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId, opportunityScore])
}

model BlogIntelligence {
  id                String          @id @default(cuid())
  seoIntelligenceId String
  title             String
  keyword           String
  intent            String
  difficulty        String
  opportunity       String
  estimatedImpact   String
  outline           Json?
  metaDescription   String?
  createdAt         DateTime        @default(now())
  seoIntelligence   SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId, opportunity])
}

model ContentGapRecord {
  id                  String          @id @default(cuid())
  seoIntelligenceId   String          @unique
  contentGaps         Json
  landingPageIdeas    Json
  comparisonPageIdeas Json
  faqOpportunities    Json
  geoContentIdeas     Json
  resourcePageIdeas   Json
  contentCalendar     Json
  summary             Json
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  seoIntelligence     SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model BlogIntelligenceRecord {
  id                 String          @id @default(cuid())
  seoIntelligenceId  String          @unique
  blogIdeas          Json
  blogClusters       Json
  blogBriefs         Json
  publishingCalendar Json
  summary            Json
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  seoIntelligence    SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model CompetitorSeoRecord {
  id                 String          @id @default(cuid())
  seoIntelligenceId  String          @unique
  competitors        Json
  competitorProfiles Json
  keywordGaps        Json
  contentGaps        Json
  authorityGaps      Json
  geoGaps            Json
  competitorMatrix   Json
  recommendations    Json
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  seoIntelligence    SeoIntelligence @relation(fields: [seoIntelligenceId], references: [id], onDelete: Cascade)

  @@index([seoIntelligenceId])
}

model AgentRun {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  agentType String
  status    String
  input     Json?
  output    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([userId])
}

model AutomationPlan {
  id                  String            @id @default(cuid())
  userId              String
  chatId              String            @unique
  campaignName        String
  campaignObjective   String?
  targetAudience      Json?
  channels            Json?
  weeklyPlan          Json?
  kpis                Json?
  budgetSplit         Json?
  emailSequence       Json?
  emailSubjects       Json?
  emailSchedule       Json?
  leadCriteria        Json?
  linkedInCalendar    Json?
  linkedInPosts       Json?
  linkedInDmTemplates Json?
  linkedInSchedule    Json?
  instagramCaptions   Json?
  instagramReelIdeas  Json?
  instagramSchedule   Json?
  instagramHashtags   Json?
  posterPrompts       Json?
  imageAdIdeas        Json?
  designStyles        Json?
  videoScripts        Json?
  videoScenes         Json?
  videoSchedule       Json?
  idealLeadProfile    Json?
  leadSources         Json?
  outreachAngles      Json?
  sampleLeads         Json?
  readinessScore      Int?              @default(0)
  status              String            @default("draft")
  provider            String?
  fallbackUsed        Boolean?          @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  contentCalendar     Json?
  crmWorkflows        Json?
  googleAds           Json?
  workflows           Json?
  contentStudio       Json?
  emailCampaigns      Json?
  creativeStudio      Json?
  videoStudio         Json?
  campaignPlans       Json?
  socialCalendars     Json?
  analyticsData       Json?
  opportunities       Json?
  risks               Json?
  readinessChecklist  Json?
  contextSnapshotId   String?
  campaignPlanId      String?
  campaignPlanVersion Int?
  generatedAt         DateTime?
  assets              AutomationAsset[]
  chat                Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionRecords    ExecutionRecord[]

  @@index([userId])
  @@index([chatId])
}

model EvidenceSnapshot {
  id                   String    @id @default(cuid())
  userId               String
  chatId               String
  analysisId           String?
  websiteUrl           String
  companyName          String?
  sourceSummary        Json?
  websiteEvidence      Json?
  technicalSeoEvidence Json?
  contentEvidence      Json?
  competitorEvidence   Json?
  githubEvidence       Json?
  rawEvidence          Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  analysis             Analysis? @relation(fields: [analysisId], references: [id])
  chat                 Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([userId])
  @@index([analysisId])
}

model AutomationAsset {
  id               String         @id @default(cuid())
  automationPlanId String
  assetType        String
  assetTitle       String
  assetContent     Json
  channel          String?
  status           String         @default("draft")
  scheduledFor     DateTime?
  publishedAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  automationPlan   AutomationPlan @relation(fields: [automationPlanId], references: [id], onDelete: Cascade)

  @@index([automationPlanId, status])
  @@index([automationPlanId, assetType])
}

model AutomationLog {
  id        String   @id @default(cuid())
  userId    String
  chatId    String?
  assetId   String?
  action    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([chatId, action])
}

model ExecutionRecord {
  id                 String          @id @default(cuid())
  userId             String
  chatId             String
  automationPlanId   String?
  module             String
  contextSnapshotId  String?
  provider           String?
  requestStatus      String
  providerResponseId String?
  assetUrls          Json?
  errorCategory      String?
  retryCount         Int             @default(0)
  maxRetries         Int             @default(3)
  requestPayload     Json?
  responseSummary    Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  automationPlan     AutomationPlan? @relation(fields: [automationPlanId], references: [id])
  chat               Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
